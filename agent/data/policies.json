        "facts": {
          "volume_ml": 100
        },
        "expected": "not_prohibited_by_rule"
      },
      {
        "query": "Can I send 101 ml perfume?",
        "facts": {
          "volume_ml": 101
        },
        "expected": "prohibited"
      },
