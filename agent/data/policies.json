[
  {
    "id": "pricing",
    "version": 1,
    "topic": "pricing",
    "text": "| Service | Delivery time | Price (up to 2 kg) |\n|---|---|---|\n| Standard | 3–5 working days | £3.95 |\n| Next Day | Next working day | £6.50 |\n| Same Day (London only) |  By 9pm on the day the order is processed. Orders received by 11am on a working day are processed that day; orders received after 11am or on a non-working day are processed the next working day. | £12.00 |\n\nParcels over 2 kg cost an extra £1.50 per kg. The maximum weight is 20 kg.",
    "aliases": [
      "delivery services and prices"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "cutoffs",
    "version": 1,
    "topic": "cutoffs",
    "text": "- Next Day: order by 4pm on a working day.\n- Same Day: order by 11am, London postcodes only.\n- Orders after the cut-off are processed the next working day.",
    "aliases": [
      "order cut-off times"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "calendar",
    "version": 1,
    "topic": "calendar",
    "text": "Working days are Monday to Friday, excluding UK bank holidays. We do not deliver on Sundays.",
    "aliases": [
      "working days"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "refunds",
    "version": 1,
    "topic": "refunds",
    "text": "- If a Next Day or Same Day parcel arrives late, we refund the delivery fee in full.\n- Standard parcels are only eligible for a refund if they arrive more than 2 working days late.\n- We never refund the value of the item itself for late delivery.\n- Refunds are processed within 5 working days to the original payment method.\n- Support assistants cannot issue refunds directly. Customers must submit a claim at parcelpigeon.example/claims.",
    "aliases": [
      "late deliveries and refunds"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "compensation",
    "version": 1,
    "topic": "compensation",
    "text": "- Report a lost parcel within 28 days of the expected delivery date.\n- Report damage within 7 days of delivery, with photos.\n- Compensation is capped at £50 per parcel unless the customer bought Pigeon Protect cover.",
    "aliases": [
      "lost or damaged parcels"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "cover",
    "version": 1,
    "topic": "cover",
    "text": "Pigeon Protect raises compensation to the declared value, up to £500. It costs £2.50 per parcel and must be added at checkout. It cannot be added after a parcel has been sent.",
    "aliases": [
      "pigeon protect cover"
    ],
    "active": true,
    "tests": []
  },
  {
    "id": "address_change",
