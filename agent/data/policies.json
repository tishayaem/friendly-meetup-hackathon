    "id": "prohibited-perfume",
    "version": 1,
    "topic": "prohibited_items",
    "text": "Perfume over 100 ml is prohibited.",
    "aliases": [
      "perfume",
      "cologne",
      "fragrance",
      "eau de parfum"
    ],
    "active": true,
    "rule": {
      "required": [
        "volume_ml"
      ],
      "conditions": [
        {
          "field": "volume_ml",
          "op": "gt",
          "value": 100
        }
      ],
      "outcome": "prohibited"
    },
    "tests": [
      {
        "query": "Can I send cologne?",
        "facts": {},
        "expected": "needs_information"
      },
      {
        "query": "Can I send 99 ml perfume?",
